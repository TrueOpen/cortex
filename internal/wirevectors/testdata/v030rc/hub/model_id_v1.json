{
  "negative": [
    {
      "expect": "reject_provider_not_canonical",
      "input": {
        "provider": "huggingface"
      },
      "name": "provider_lower_case",
      "reason": "The provider token is case-sensitive and never normalized."
    },
    {
      "expect": "reject_provider_not_canonical",
      "input": {
        "provider": "HF"
      },
      "name": "provider_alias",
      "reason": "Only the closed canonical tokens are accepted."
    },
    {
      "expect": "reject_provider_not_canonical",
      "input": {
        "provider": ""
      },
      "name": "provider_empty",
      "reason": "An empty provider is not a canonical token."
    },
    {
      "expect": "reject_provider_not_supported",
      "input": {
        "provider": "OCI"
      },
      "name": "provider_not_supported",
      "reason": "OCI is a canonical token, but only HUGGINGFACE is accepted in this version."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id": "Qwen3-8B"
      },
      "name": "repo_id_without_slash",
      "reason": "A Hugging Face repo_id has exactly one slash."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id": "Qwen/Qwen3/8B"
      },
      "name": "repo_id_two_slashes",
      "reason": "A Hugging Face repo_id has exactly one slash."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id": "Qwen/"
      },
      "name": "repo_id_empty_segment",
      "reason": "Both segments must be non-empty."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id": "Qwen/Qwen3 8B"
      },
      "name": "repo_id_outside_charset",
      "reason": "Only [A-Za-z0-9._-] is allowed in each segment."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id": " Qwen/Qwen3-8B"
      },
      "name": "repo_id_surrounding_whitespace",
      "reason": "Leading or trailing whitespace is rejected, never trimmed."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id_hex": "5177656e2f43616665cc81"
      },
      "name": "repo_id_not_nfc",
      "reason": "Not in NFC: e followed by U+0301 COMBINING ACUTE ACCENT, whose NFC form is the precomposed character. It is rejected, never normalized."
    },
    {
      "expect": "reject_repo_id",
      "input": {
        "repo_id_length_bytes": 256
      },
      "name": "repo_id_too_long",
      "reason": "repo_id is at most 255 bytes."
    },
    {
      "expect": "reject_proposer_address",
      "input": {
        "proposer_address": "TRUEOPEN1RFJZ7R3U8T65TEAVH5UTQUJ3KWVSJ983P3JCLZ"
      },
      "name": "proposer_not_canonical_bech32",
      "reason": "The address must be canonical lowercase Bech32."
    },
    {
      "expect": "reject_proposer_address",
      "input": {
        "proposer_address": "cosmos1rfjz7r3u8t65teavh5utquj3kwvsj983p3jclz"
      },
      "name": "proposer_wrong_hrp",
      "reason": "The HRP must be trueopen."
    },
    {
      "expect": "reject_chain_id",
      "input": {
        "chain_id": ""
      },
      "name": "chain_id_empty",
      "reason": "chain_id is required and must equal the chain the registration is submitted to."
    }
  ],
  "notes": [
    "The identity is an opaque raw Hash32, derived from the immutable repository coordinates and the decoded proposer address.",
    "P1 to P4 pin owner binding, case preservation and chain separation. Rows under tamper change the encoding and must not reproduce the base digest. Rows under negative must be rejected before any identity is derived; each names the input that differs from P1."
  ],
