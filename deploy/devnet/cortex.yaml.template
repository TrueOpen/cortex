mode: real
chain_id: @@CHAIN_ID@@
admin:
  uds_path: /var/run/cortex/cortexd.sock
model_management:
  endpoint: @@MODEL_ENDPOINT@@
  transport: grpc
  # A model service on another host must use TLS (deployment security baseline items 4
  # and 5); only a loopback endpoint may be plaintext.
  # pubkey_hash = the 64 lowercase hex chars of sha256(certificate SubjectPublicKeyInfo DER).
  tls:
    pubkey_hash: "@@MODEL_TLS_PUBKEY_HASH@@"
node:
  rpc_endpoint: @@NODE_RPC@@
  rest_endpoint: @@NODE_REST@@
  # A node with a self-signed certificate: pin its public key (or set ca_file)
  # instead of relying on SSL_CERT_FILE. Endpoints must then be https://.
  # tls:
  #   pubkey_hash: "<sha256 of the node certificate SubjectPublicKeyInfo DER, 64 lowercase hex>"
keeper:
  api_url: @@KEEPER_API@@
  poll_interval_ms: 1000
  max_lag_blocks: 20
task_execution:
  retry_delay_ms: 30000
  # grpc model transport: Workers resolve the receiving Builder's descriptor
  # and use current Cortex service-key auth for metadata plus ranged
  # FetchTaskData. Bytes are plaintext, so keep task-data endpoints on verified
  # TLS except for the explicit devnet-only insecure-descriptor opt-in.
  input_resolver: nexus
nexus:
  ingress_url: @@NEXUS_INGRESS@@
  auth_token_file: /run/secrets/nexus.token
  # Set to the Builder operator that owns NEXUS_INGRESS to enable descriptor
  # verification. Leave empty until the Builder publishes a service descriptor
  # that commits this endpoint.
  builder_operator_address: "@@NEXUS_BUILDER_OPERATOR@@"
  allow_insecure_descriptor: false
tx:
  enabled: true
  max_fee_amount: 1000000
  fee_denom: uusdc
  max_attempts: 5
  poll_attempts: 30
  gas_limit: 250000
artifacts:
  root: /var/lib/cortex/evidence
  retention_policy_version: @@RETENTION_POLICY_VERSION@@
  minimum_retention_blocks: @@MINIMUM_RETENTION_BLOCKS@@
store:
  path: /var/lib/cortex/store
signer:
  uri: @@SIGNER_URI@@
  readiness_proof_interval_ms: 30000
local_identity:
  operator_address: @@OPERATOR_ADDRESS@@
  service_key_ref: @@SERVICE_KEY_REF@@
  supported_model_profiles: [@@MODEL_PROFILES@@]
  model_service_id: @@MODEL_SERVICE_ID@@
self_rescue:
  # This gates the DEADLINE-RISK trigger only, and its automatic deadline
  # scheduling is not wired yet; see Cortex issue #108. It does NOT gate the
  # verifier commit exit: a signed verify commit has no relay to travel on, so
  # this node submits its own MsgSubmitVerifyCommit every round regardless. That
  # is why tx.enabled above is required, not optional.
  enabled: false
  # Per-transaction bound for that commit exit as well. It may only narrow
  # tx.max_fee_amount, never widen it.
  max_fee_amount: 1000000
challenge_verifier:
  enabled: false
health:
  bind: 0.0.0.0:8081
