# Copy to deploy/testnet/.env and chmod 600. Never put private keys here.
# The keystore password below is a dev-test convenience; do not reuse it
# anywhere holding value.

# --- where it runs ---
CORTEX_SSH_HOST=gpu-test
CORTEX_REMOTE_ROOT=/opt/cortex
CORTEX_NODE_COUNT=4
CORTEX_HEALTH_PORT_BASE=18080

# --- local key material, pushed to the server by `push` ---
# One directory per node: $CORTEX_KEYSTORE_DIR/node1/service.json
CORTEX_KEYSTORE_DIR=/absolute/path/to/keystores
CORTEX_KEYSTORE_PASSWORD=cortexdev
CORTEX_NEXUS_TOKEN_FILE=/absolute/path/to/nexus.token

# --- devnet endpoints, shared by all nodes ---
CORTEX_CHAIN_ID=trueopen-devnet-1
CORTEX_NODE_RPC=https://rpc.devnet.example
CORTEX_NODE_REST=https://api.devnet.example
CORTEX_KEEPER_API=https://keeper.devnet.example
CORTEX_NEXUS_INGRESS=https://nexus.devnet.example
CORTEX_NEXUS_NATS=tls://nats.devnet.example:4222
# Required for a remote NATS in real mode: the distributed server certificate
# or CA PEM on the node (ADR-0016 transitional state).
CORTEX_NEXUS_NATS_CA_FILE=
# Required for a remote NATS in real mode: cortex's on-chain NATS user key
# (ed25519 nkey seed file). Real mode no longer accepts a creds file
# (ADR-0016 decision three).
CORTEX_NEXUS_NATS_USER_KEY_FILE=
# JetStream stream the deployed Nexus publishes task frames to. Cortex creates
# and binds its own durable consumer on it, so a stop unbinds instead of
# deleting the consumer. Required in real mode; devnet ships TRUEOPEN_TASK.
CORTEX_NEXUS_JETSTREAM_STREAM=TRUEOPEN_TASK
CORTEX_MODEL_ENDPOINT=127.0.0.1:9090
# Required unless CORTEX_MODEL_ENDPOINT is loopback: sha256 of the model
# service certificate's SubjectPublicKeyInfo (64 lowercase hex).
CORTEX_MODEL_TLS_PUBKEY_HASH=

# Integration without a live model service: the fake transport must be paired
# with the fixture input resolver, and both are dev-only. Leave unset to use the
# transport configured in the template.
# CORTEX_MODEL_TRANSPORT=fake
# CORTEX_TASK_INPUT_RESOLVER=fixture
# CORTEX_TASK_FIXTURE_ROOT=/opt/cortex/fixtures
# Required with CORTEX_MODEL_TRANSPORT=local. Size this admission budget from
# measured end-to-end throughput and latency, not directly from --max-num-seqs.
# CORTEX_MODEL_MAX_CONCURRENCY=4
CORTEX_MODEL_ID=llama-main
CORTEX_MODEL_PROFILES=llama-main@1=llm_text_v1
CORTEX_MODEL_SERVICE_ID=model-service-dev
# OPTIONAL. Set it to the Builder operator that owns CORTEX_NEXUS_INGRESS to
# verify that Builder's on-chain service descriptor and to narrow inbound bus
# traffic to it. Empty leaves descriptor verification disabled and admits every
# Builder in the chain's current BuilderSet, which is what authorizes senders in
# strict mode; `render` requires this variable in no mode.
CORTEX_NEXUS_BUILDER_OPERATOR=
# Posture. real is fail-closed and refuses the two dev-only Nexus flags below;
# integration wires the same dependencies and admits them, which is the only
# startable way to exercise the loop while the deployed Nexus publishes unsigned
# envelopes (TrueOpen/nexus#45). fake builds no task runner and subscribes to no
# bus, so it proves strictly less than either. Never promote integration.
CORTEX_MODE=real
CORTEX_NEXUS_ALLOW_INSECURE_DESCRIPTOR=false
# Envelope authentication. The rendered template sets nexus.envelope_auth_mode
# explicitly to strict, which signs every outbound envelope with the node's
# current service key and requires a valid signature on every inbound one. The
# Nexus that ships today emits unsigned BusEnvelopes, so a strict node rejects
# every Builder message and takes no work. trusted_nats_dev relaxes the
# signature layer only, never the wire shape: DecodeBusEnvelope refuses any
# frame that is not the full 20-field envelope
# (internal/builderclient/envelope.go:553-567 -- DisallowUnknownFields plus
# validateWireShape), and the coordinator still publishes the 14-field
# msgbus.BusEnvelope (TrueOpen/nexus#45). So uncommenting it runs a task loop
# for the synthetic 20-field smoke order, not for a real Builder frame.
# This one variable is
# forwarded to the remote cortexd by `up` (CORTEX_FORWARDED_OVERRIDES).
# CORTEX_NEXUS_ENVELOPE_AUTH_MODE=trusted_nats_dev
# Envelope TTL and tolerated clock skew, in milliseconds. Deployment config
# rather than chain parameters: keep them equal to the values the deployed Nexus
# uses. The template already carries the 30000/2000 pair, and these two names
# are not in CORTEX_FORWARDED_OVERRIDES, so change the template rather than
# expecting an override from this file.
# CORTEX_NEXUS_ENVELOPE_TTL_MS=30000
# CORTEX_NEXUS_ENVELOPE_CLOCK_SKEW_MS=2000
# The rendered config pins task_execution.input_resolver: nexus, so Workers
# fetch plaintext task input from the receiving Builder's Nexus. It is not
# templated from this file; `fixture` is only legal with a fake model
# transport and is not a testnet shape.
CORTEX_RETENTION_POLICY_VERSION=retention-v1
CORTEX_MINIMUM_RETENTION_BLOCKS=100800

# --- per-node identity ---
# Operator addresses come from offline registration tooling and must identify a
# registered CortexNode on chain before workload readiness can pass. There is no
# per-node duty any more: every node holds both the WORKER and the VERIFIER
# responsibility and is drawn for either by the chain.
CORTEX_NODE1_OPERATOR_ADDRESS=trueopen1operator1

CORTEX_NODE2_OPERATOR_ADDRESS=trueopen1operator2

CORTEX_NODE3_OPERATOR_ADDRESS=trueopen1operator3

CORTEX_NODE4_OPERATOR_ADDRESS=trueopen1operator4

# --- smoke (`scripts/testnet-deploy.sh smoke confirm`) ---
# Required when node1's nexus.builder_operator_address is empty
# (scripts/testnet-deploy.sh:359,364). That field is an optional narrowing
# filter in every mode, not a trusted_nats_dev setting
# (internal/config/config.go:133-144,166-168).
# This is the sender_operator_address on the synthetic OPEN_TASK, not a
# key Cortex loads. The remaining 20-field flags are filled by smoke_publish:
# snapshot-height = live tip, builder-set-id default "smoke", hash = sha256(id),
# authorization-nonce default 1.
# CORTEX_SMOKE_BUILDER=trueopen1...

