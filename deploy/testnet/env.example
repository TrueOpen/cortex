# Copy to deploy/testnet/.env and chmod 600. Never put private keys here.
# The keystore password below is a dev-test convenience; do not reuse it
# anywhere holding value.

# --- where it runs ---
CORTEX_SSH_HOST=gpu-test
CORTEX_REMOTE_ROOT=/opt/cortex
CORTEX_NODE_COUNT=4
CORTEX_HEALTH_PORT_BASE=18080

# --- local key material, pushed to the server by `push` ---
# One directory per node: $CORTEX_KEYSTORE_DIR/node1/service.json
CORTEX_KEYSTORE_DIR=/absolute/path/to/keystores
CORTEX_KEYSTORE_PASSWORD=cortexdev
CORTEX_NEXUS_TOKEN_FILE=/absolute/path/to/nexus.token

# --- devnet endpoints, shared by all nodes ---
CORTEX_CHAIN_ID=trueopen-devnet-1
CORTEX_NODE_RPC=https://rpc.devnet.example
CORTEX_NODE_REST=https://api.devnet.example
CORTEX_KEEPER_API=https://keeper.devnet.example
CORTEX_NEXUS_INGRESS=https://nexus.devnet.example
CORTEX_MODEL_ENDPOINT=127.0.0.1:9090
# Required unless CORTEX_MODEL_ENDPOINT is loopback: sha256 of the model
# service certificate's SubjectPublicKeyInfo (64 lowercase hex).
CORTEX_MODEL_TLS_PUBKEY_HASH=

# Integration without a live model service: the fake transport must be paired
# with the fixture input resolver, and both are dev-only. Leave unset to use the
# transport configured in the template.
# CORTEX_MODEL_TRANSPORT=fake
# CORTEX_TASK_INPUT_RESOLVER=fixture
# CORTEX_TASK_FIXTURE_ROOT=/opt/cortex/fixtures
# Required with CORTEX_MODEL_TRANSPORT=local. Size this admission budget from
# measured end-to-end throughput and latency, not directly from --max-num-seqs.
# CORTEX_MODEL_MAX_CONCURRENCY=4
# CORTEX_MODEL_ID is the chain's Hash32 model id as 64 lowercase hex (a
# placeholder below). Find the id of a registered model with
#   cortexctl model find --rpc <keeper-rpc> --provider HUGGINGFACE --repo <owner/name>
# The vLLM served model name must equal that model's chain repo_id.
CORTEX_MODEL_ID=c2e5065e9dda862ec6970d2c54765ad9414f22fe7ae82cf94dae6825828129c1
CORTEX_MODEL_PROFILES=c2e5065e9dda862ec6970d2c54765ad9414f22fe7ae82cf94dae6825828129c1@1=llm_text_v1
CORTEX_MODEL_SERVICE_ID=model-service-dev
# OPTIONAL. Set it to the Builder operator that owns CORTEX_NEXUS_INGRESS to
# verify that Builder's on-chain service descriptor. Empty leaves descriptor
# verification disabled; the chain's current BuilderSet stays the authority.
# `render` requires this variable in no mode.
CORTEX_NEXUS_BUILDER_OPERATOR=
# Posture. real is fail-closed and refuses the two dev-only Nexus flags below;
# integration wires the same dependencies and admits them. fake builds no task
# runner and opens no Builder stream, so it proves strictly less than either.
# Never promote integration.
CORTEX_MODE=real
CORTEX_NEXUS_ALLOW_INSECURE_DESCRIPTOR=false
# The rendered config pins task_execution.input_resolver: nexus, so Workers
# fetch plaintext task input from the receiving Builder's Nexus. It is not
# templated from this file; `fixture` is only legal with a fake model
# transport and is not a testnet shape.
CORTEX_RETENTION_POLICY_VERSION=retention-v1
CORTEX_MINIMUM_RETENTION_BLOCKS=100800

# --- per-node identity ---
# Operator addresses come from offline registration tooling and must identify a
# registered CortexNode on chain before workload readiness can pass. There is no
# per-node duty any more: every node holds both the WORKER and the VERIFIER
# responsibility and is drawn for either by the chain.
CORTEX_NODE1_OPERATOR_ADDRESS=trueopen1operator1

CORTEX_NODE2_OPERATOR_ADDRESS=trueopen1operator2

CORTEX_NODE3_OPERATOR_ADDRESS=trueopen1operator3

CORTEX_NODE4_OPERATOR_ADDRESS=trueopen1operator4

# --- smoke (`scripts/testnet-deploy.sh smoke`) ---
# Read-only: /readyz and every dispatch_stream:<builder> row per node. Needs
# jq locally. Nothing is published.


# --- Phase 1 dispatch (real mode refuses to start without these) ---
# Comma-separated Builder operators (BuilderSet members) to keep a standing
# handraise with. Endpoints and TLS pins come from their on-chain descriptors.
CORTEX_DISPATCH_BUILDERS=trueopen1crqu9s7ychrv0jxfet9uenwwelgdr5knutsmxe
# 参数表 values every Builder shares; take them from the deployed parameter table.
CORTEX_DISPATCH_EVIDENCE_RETENTION_BLOCKS=201600
CORTEX_DISPATCH_HEARTBEAT_MS=10000
CORTEX_DISPATCH_TTL_MS=30000
CORTEX_DISPATCH_MIN_CHANGE_INTERVAL_MS=500
# Local price floor for the rendered profile (per 1,000,000 output tokens), > 0.
CORTEX_DISPATCH_MIN_PRICE_BID=1000
# Stream liveness, deployment settings: agree them with the Builders.
CORTEX_DISPATCH_KEEPALIVE_MS=15000
CORTEX_DISPATCH_KEEPALIVE_MAX_MISSED=3
CORTEX_DISPATCH_RESCUE_MARGIN_BLOCKS=5
CORTEX_DISPATCH_ROSTER_GRACE_BLOCKS=20
CORTEX_DISPATCH_CHALLENGE_MARGIN_BLOCKS=5
# CORTEX_MODEL_MAX_CONCURRENCY=1
